<time-stamp>
	<p><strong>Time:</strong> <span>loading...</span></p>
</time-stamp>

<script>
	class TimeStamp extends HTMLElement {
		connectedCallback() {
			const span = this.querySelector('span');
			function time() {
				const d = new Date();
				const h = d.getHours().toString();
				const m = d.getMinutes().toString();
				const s = d.getSeconds().toString();

				if (h.length === 1) {
					span.textContent = `0${h}:${m}:${s}`;
				} else if (m.length === 1) {
					span.textContent = `${h}:0${m}:${s}`;
				} else if (s.length === 1) {
					span.textContent = `${h}:${m}:0${s}`;
				} else {
					span.textContent = `${h}:${m}:${s}`;
				}
			}

			setInterval(time);
		}
	}

	customElements.define('time-stamp', TimeStamp);
</script>
